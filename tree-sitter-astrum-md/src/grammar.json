{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "astrum_md",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_block"
      }
    },
    "_block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "heading1"
        },
        {
          "type": "SYMBOL",
          "name": "heading2"
        },
        {
          "type": "SYMBOL",
          "name": "heading3"
        },
        {
          "type": "SYMBOL",
          "name": "heading4"
        },
        {
          "type": "SYMBOL",
          "name": "heading5"
        },
        {
          "type": "SYMBOL",
          "name": "heading6"
        },
        {
          "type": "SYMBOL",
          "name": "subheading"
        },
        {
          "type": "SYMBOL",
          "name": "paragraph"
        },
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "blank_line": {
      "type": "PATTERN",
      "value": "\\n[ \\t]*\\n"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "heading6": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "######"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading5": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#####"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading4": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "####"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading3": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "###"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading2": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "##"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "heading1": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "subheading": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-#"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "paragraph": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_inline_content"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_inline_content": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_inline"
        }
      }
    },
    "_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "code_span"
        },
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "underline"
        },
        {
          "type": "SYMBOL",
          "name": "strikethrough"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "code_span": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "`"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "[^`\\n]+"
            }
          },
          "named": true,
          "value": "code_content"
        },
        {
          "type": "STRING",
          "value": "`"
        }
      ]
    },
    "bold": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "**"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_bold_content"
            },
            "named": true,
            "value": "content"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "**"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_bold_content": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "([^*\\n]|\\*[^*])+"
        }
      }
    },
    "italic": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_italic_content"
            },
            "named": true,
            "value": "content"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_italic_content": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^*\\n]+"
        }
      }
    },
    "underline": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "__"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_underline_content"
            },
            "named": true,
            "value": "content"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "__"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_underline_content": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "([^_\\n]|_[^_])+"
        }
      }
    },
    "strikethrough": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "~~"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_strikethrough_content"
            },
            "named": true,
            "value": "content"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "~~"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_strikethrough_content": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "([^~\\n]|~[^~])+"
        }
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n*_~`#]+|[*_~#]"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}